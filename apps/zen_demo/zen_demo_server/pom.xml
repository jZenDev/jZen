<?xml version="1.0" encoding="UTF-8"?>
<!--
  zen-demo-server :: the reference app's runnable Quarkus backend. The only module with
  <packaging>quarkus</packaging>; every other module is a plain jar.

  Assembles the framework libraries into a runnable backend: the REST surface, the
  infrastructure filters, and the generated openapi.json.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    The reference backend: the runnable Quarkus application that assembles the jZen framework
    libraries (zen-transport, zen-identity, ...) into a working server. It lives under apps/
    (not server/, which is now framework libraries only), and inherits zen-parent across
    directories via relativePath - the parent supplies the BOM, Java version, and plugin
    management, while the framework lib artifacts resolve from the local repo (server/ installs
    them first). A product backend such as apps/workspaces/server is built the same way.
  -->
  <parent>
    <groupId>zen</groupId>
    <artifactId>zen-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../server/pom.xml</relativePath>
  </parent>

  <artifactId>zen-demo-server</artifactId>
  <name>jZen :: zen_demo :: server</name>
  <packaging>quarkus</packaging>

  <dependencies>
    <dependency>
      <groupId>zen</groupId>
      <artifactId>zen-core</artifactId>
    </dependency>
    <dependency>
      <groupId>zen</groupId>
      <artifactId>zen-proto</artifactId>
    </dependency>
    <dependency>
      <groupId>zen</groupId>
      <artifactId>zen-transport</artifactId>
    </dependency>
    <dependency>
      <groupId>zen</groupId>
      <artifactId>zen-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>zen</groupId>
      <artifactId>zen-email</artifactId>
    </dependency>
    <!-- Guaranteed scheduled work: supplies the trigger endpoint, the zen_jobs table, and the
         ZenJob this app implements in zen.demo.jobs.UserRetentionZenJob. -->
    <dependency>
      <groupId>zen</groupId>
      <artifactId>zen-jobs</artifactId>
    </dependency>
    <!-- The abuse layer: per-address rate limiting on the API surface, plus the cleanup ZenJob
         that bounds its counter table. Assembling it is all an application does - the limits are
         production values by default, so an app that says nothing about zen.ratelimit.* still
         gets protection rather than an open door. See DECISIONS ADR-029. -->
    <dependency>
      <groupId>zen</groupId>
      <artifactId>zen-ratelimit</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <!-- Qute @MessageBundle backs the demo's typed, localized server messages (DemoMessages +
         the @Localized("uk") variant), replacing hand-rolled .properties lookups. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-qute</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <!-- Backs the demo /api/v1/demo/ws echo endpoint (DemoWebSocket). zen_demo drives it via
         zen_transport's ZenWebSocket. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-websockets-next</artifactId>
    </dependency>
    <!-- No quarkus-rest-jackson: see the note in zen-transport/pom.xml. Response bodies
         are proto messages serialized by the transport module's writers. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>

    <!-- quarkus-smallrye-openapi is NOT here. It is a build-tooling dependency, not a runtime one,
         so it lives in the `openapi` profile below and is absent from the native image prod ships.
         See that profile for the whole reasoning. -->

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-logging-json</artifactId>
    </dependency>
    <!-- The %dev in-process tick that drives zen-jobs locally. In %prod the trigger is external
         (Cloud Scheduler), because a cron cannot fire on a scale-to-zero runtime. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-scheduler</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- AdminUserResourceTest mints an admin SecurityIdentity via @TestSecurity to exercise the
         @RolesAllowed("admin") gate on the framework's admin resource. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- AuthResourceTest mocks the @RegisterRestClient SupabaseAuthClient (real Supabase is
         exercised end to end by zen_demo in ROADMAP step 4). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5-mockito</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Declared with NO <executions>, deliberately. This module is <packaging>quarkus</packaging>
        and the parent registers the plugin with <extensions>true</extensions>, so that packaging's
        own lifecycle already binds generate-code, generate-code-tests and build to their phases.

        The archetype's explicit <execution> listing those three goals is correct for a `jar`
        module and a DUPLICATE here: it binds `build` a second time, so `mvn package -Dnative`
        compiles the native image TWICE and the second overwrites the first. That cost ~4.5
        minutes per extra build on every deploy and every `test:native`, invisibly, because both
        builds succeed and the output is identical.
      -->
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      OpenAPI is BUILD TOOLING, and the profile is what makes that true rather than merely said.

      quarkus-smallrye-openapi exists in this repository to produce one file: the merged
      openapi.json that `task generate:api:schema` writes to target/openapi and that
      openapi-typescript turns into the admin panel's schema.generated.ts (STANDARDS "Source of
      truth"). That is a build-time job. Shipping the extension additionally serves /openapi to
      the internet for the life of every deployed revision, which the audit found it doing
      (SECURITY-REMEDIATION F15): a complete, always-current map of every route, verb, parameter
      and status code the service accepts, published to anyone who asks. Nothing needs it there.

      WHY A PROFILE AND NOT A CONFIG SWITCH. quarkus.smallrye-openapi.enable=false would stop the
      endpoint and still bake the extension, its scanner and its dependencies into the image, so
      the attack surface argument survives and the cold-start one is untouched. Removing the
      dependency removes the code.

      WHY THE DEFAULT KEEPS IT, and why getting this backwards is expensive. The activation is
      inverted deliberately: this profile is ON unless -Dnative is passed, so every ordinary
      build, every test run and every contract regeneration still has the extension. Excluding it
      from the default build instead would break `task sync:contracts` — generate:api:schema would
      package cleanly, write no openapi.json, and generate:api:ts would then SKIP (its `status:`
      guard is "does openapi.json exist?"), leaving the committed schema.generated.ts stale while
      the gate reported success. The eventual symptom is a TypeScript error in the admin panel
      about a field that does exist, and nothing in it mentions OpenAPI.

      WHY IT IS SAFE TO DIFFER. The extension contributes no runtime behaviour to this
      application: no bean any resource injects, no filter, no provider. Resources are annotated
      with @APIResponse/@Schema from the MicroProfile OpenAPI API, which is compile-time metadata
      — those annotations are simply not read when nothing is there to read them. The native and
      default builds therefore serve identical traffic, and test:native proves it by running the
      full verify:endpoints assertion set against the real image.
    -->
    <profile>
      <id>openapi</id>
      <activation>
        <property><name>!native</name></property>
      </activation>
      <dependencies>
        <!-- Derives openapi.json from the annotated resources. It cannot introspect
             protobuf-generated classes cleanly, so model schemas are merged in from a static
             META-INF/openapi.yaml instead. See STANDARDS.md "OpenAPI and the REST surface". -->
        <dependency>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
