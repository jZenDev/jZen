{
  "@@locale": "en",
  "conflictsTitle": "Changed on Two Devices",
  "@conflictsTitle": {
    "description": "Title of the screen listing records that need the person to choose a version."
  },
  "conflictsIntro": "These were changed differently on your devices. Nothing has been thrown away: choose which version to keep.",
  "@conflictsIntro": {
    "description": "Explanation at the top of the conflict list."
  },
  "noConflicts": "Everything is in sync.",
  "@noConflicts": {
    "description": "Shown on the conflict list when there is nothing left to decide."
  },
  "bannerText": "{count, plural, =1{1 item was changed on two devices and needs your choice.} other{{count} items were changed on two devices and need your choice.}}",
  "@bannerText": {
    "description": "Banner shown while conflicts wait for the person.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "reviewButton": "Review",
  "@reviewButton": {
    "description": "Banner button that opens the conflict list."
  },
  "resolveTitle": "Choose a Version",
  "@resolveTitle": {
    "description": "Title of the screen that shows each device's version of one record."
  },
  "resolveIntro": "{title} was changed on more than one device. Keep one version; the others are replaced on every device.",
  "@resolveIntro": {
    "description": "Explanation above the versions of one record.",
    "placeholders": {
      "title": {
        "type": "String"
      }
    }
  },
  "sideHeading": "{device}, {time}",
  "@sideHeading": {
    "description": "Heading of one version: the device it came from and when it was written there.",
    "placeholders": {
      "device": {
        "type": "String"
      },
      "time": {
        "type": "String"
      }
    }
  },
  "deletedHere": "Deleted on this device",
  "@deletedHere": {
    "description": "What a version shows when that device deleted the record."
  },
  "notSet": "(empty)",
  "@notSet": {
    "description": "Value shown for a field that is not set in one version."
  },
  "keepThisVersion": "Keep this version",
  "@keepThisVersion": {
    "description": "Button that resolves the conflict with this version."
  },
  "keepDeleted": "Keep it deleted",
  "@keepDeleted": {
    "description": "Button that resolves the conflict by deleting the record."
  },
  "resolveFailed": "Couldn't save your choice. Try again.",
  "@resolveFailed": {
    "description": "Error when a resolution could not be written."
  },
  "deletedTitle": "A deleted item",
  "@deletedTitle": {
    "description": "Name used for a record when every version shown of it is a delete."
  },
  "syncNoAccount": "Not syncing: this device isn't signed in to iCloud. Your data is safe here; sign in under Settings to sync it.",
  "@syncNoAccount": {
    "description": "Sync status: the device has no iCloud account."
  },
  "syncKeychainUnavailable": "Not syncing: iCloud Keychain is off, so your encrypted data can't be read here. Turn it on under Settings → iCloud → Passwords and Keychain.",
  "@syncKeychainUnavailable": {
    "description": "Sync status: iCloud Keychain is off or was reset."
  },
  "syncAccountChanged": "Sync stopped: this device is now signed in to a different iCloud account. Nothing was sent to it.",
  "@syncAccountChanged": {
    "description": "Sync status: the iCloud account changed and sync stopped."
  },
  "syncCloudDataDeleted": "Sync stopped: the data in iCloud was deleted. This device's copy is untouched.",
  "@syncCloudDataDeleted": {
    "description": "Sync status: the iCloud copy was deleted and sync stopped."
  },
  "syncQuotaExceeded": "Not syncing: your iCloud storage is full.",
  "@syncQuotaExceeded": {
    "description": "Sync status: iCloud storage is full."
  },
  "syncUnreadableRecords": "Some changes from another device can't be read here. Update the app on this device.",
  "@syncUnreadableRecords": {
    "description": "Sync status: another device sent data this app version cannot read."
  },
  "syncOther": "Sync isn't working right now. Your data is safe on this device.",
  "@syncOther": {
    "description": "Sync status: any other failure."
  },
  "addDeviceTitle": "Add a Device",
  "@addDeviceTitle": {
    "description": "Title of the screen that shows the code a new device joins with."
  },
  "addDeviceIntro": "On the new device, choose Join, then scan this code or type it. The code is valid for 5 minutes. Anyone who sees it can read your data, so keep the screen to yourself.",
  "@addDeviceIntro": {
    "description": "Explanation above the pairing code; the 5 minutes must match ZenPairing.lifetime."
  },
  "showCodeButton": "Show Code",
  "@showCodeButton": {
    "description": "Button that reveals the pairing code."
  },
  "cancelButton": "Cancel",
  "@cancelButton": {
    "description": "Button that closes the pairing screens without pairing."
  },
  "qrCodeLabel": "QR code with the pairing code, for the new device to scan",
  "@qrCodeLabel": {
    "description": "Accessible name of the QR image."
  },
  "pairingCodeLabel": "Pairing code",
  "@pairingCodeLabel": {
    "description": "Label of the typed pairing code, shown and entered."
  },
  "codeValidFor": "Valid for {time}",
  "@codeValidFor": {
    "description": "Countdown under the code.",
    "placeholders": {
      "time": {
        "type": "String"
      }
    }
  },
  "codeExpired": "This code has expired. It is no longer shown.",
  "@codeExpired": {
    "description": "Shown in place of an expired code."
  },
  "codeHidden": "The code was hidden because the app left the screen.",
  "@codeHidden": {
    "description": "Shown in place of a code hidden when the app went to the background."
  },
  "showNewCodeButton": "Show a New Code",
  "@showNewCodeButton": {
    "description": "Button that creates a fresh code after one expired or was hidden."
  },
  "joinTitle": "Join",
  "@joinTitle": {
    "description": "Title of the screen where a new device enters the pairing code."
  },
  "joinIntro": "On a device that already has your data, choose Add a Device. Then scan the code it shows, or type it here.",
  "@joinIntro": {
    "description": "Explanation at the top of the join screen."
  },
  "joinCodeHint": "Seven characters, then a dash, eleven times",
  "@joinCodeHint": {
    "description": "Hint inside the join field describing the code layout."
  },
  "joinButton": "Join",
  "@joinButton": {
    "description": "Button that checks the typed code and joins."
  },
  "scanButton": "Scan with Camera",
  "@scanButton": {
    "description": "Button that opens the camera to scan the QR code."
  },
  "typeInsteadButton": "Type the Code Instead",
  "@typeInsteadButton": {
    "description": "Button that returns from the camera to the typed field."
  },
  "joinWrongLength": "That is not the whole code. It has 11 groups of 7 characters.",
  "@joinWrongLength": {
    "description": "Join error: wrong length."
  },
  "joinBadCharacter": "The code has only digits and letters. Check what you typed.",
  "@joinBadCharacter": {
    "description": "Join error: a character outside the alphabet."
  },
  "joinMistyped": "Group {group} has a mistake. Compare it with the other device.",
  "@joinMistyped": {
    "description": "Join error: a check character failed; names the group.",
    "placeholders": {
      "group": {
        "type": "int"
      }
    }
  },
  "joinScrambled": "The groups are in the wrong order. Type them as shown.",
  "@joinScrambled": {
    "description": "Join error: all groups pass but the whole fails."
  },
  "joinUnsupported": "This code comes from a newer version of the app. Update this device and try again.",
  "@joinUnsupported": {
    "description": "Join error: unsupported code version."
  },
  "joinExpired": "This code has expired. Show a new one on the other device.",
  "@joinExpired": {
    "description": "Join error: expired code."
  },
  "joinFailed": "Joining did not work: {reason}",
  "@joinFailed": {
    "description": "Join error: the application could not store the key.",
    "placeholders": {
      "reason": {
        "type": "String"
      }
    }
  }
}
