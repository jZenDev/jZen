  "@bulkTitle": {
    "description": "Title of the screen that settles many records between two devices with one choice."
  },
  "bulkIntro": "{count} items were changed differently on {first} and {second}. Choose the device whose version to keep for all of them. The other version of each is replaced on every device.",
  "@bulkIntro": {
    "description": "Explanation above the settle-many choice.",
    "placeholders": {
      "count": {
        "type": "int"
      },
      "first": {
        "type": "String"
      },
      "second": {
        "type": "String"
      }
    }
  },
  "bulkKeepThisDevice": "Keep this device's version ({device}) for all {count}",
  "@bulkKeepThisDevice": {
    "description": "Button that settles every listed record with the version from the device the person is holding.",
    "placeholders": {
      "count": {
        "type": "int"
      },
      "device": {
        "type": "String"
      }
    }
  },
  "bulkKeepDevice": "Keep {device}'s version for all {count}",
  "@bulkKeepDevice": {
    "description": "Button that settles every listed record with the version from another device.",
    "placeholders": {
      "count": {
        "type": "int"
      },
      "device": {
        "type": "String"
      }
    }
  },
  "bulkIncludedHeading": "Settled together ({count})",
  "@bulkIncludedHeading": {
    "description": "Heading above the records one choice settles.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "bulkLeftHeading": "Left for you ({count})",
  "@bulkLeftHeading": {
    "description": "Heading above the records this choice does not settle.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
